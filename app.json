    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hk.organizer",
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
